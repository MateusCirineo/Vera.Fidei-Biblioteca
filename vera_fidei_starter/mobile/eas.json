{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://verafidei.oialfred.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://verafidei.oialfred.com",
        "EXPO_PUBLIC_DISTRIBUTION_MODE": "direct"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://verafidei.oialfred.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://verafidei.oialfred.com",
        "EXPO_PUBLIC_DISTRIBUTION_MODE": "direct"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://verafidei.oialfred.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://verafidei.oialfred.com",
        "EXPO_PUBLIC_DISTRIBUTION_MODE": "reader"
      }
    },
    "production-play": {
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://verafidei.oialfred.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://verafidei.oialfred.com",
        "EXPO_PUBLIC_DISTRIBUTION_MODE": "play"
      }
    }
  }
}
