DATABASE_URL=postgresql://vera:vera123@localhost:5432/vera_fidei
ELASTICSEARCH_URL=http://localhost:9200
CHROMA_PATH=./chroma_db
EMBEDDING_MODEL=BAAI/bge-m3
VERA_ENABLE_SEMANTIC_SEARCH=false
LLM_ENABLED=false
LLM_MODEL_NAME=qwen

# PDF storage
# local = usa backend/pdfs como hoje
# s3/r2 = envia novos PDFs para storage S3-compatible (Cloudflare R2, Backblaze B2, etc.)
# gdrive = envia novos PDFs para Google Drive via rclone
PDF_STORAGE=local
PDF_CACHE_DIR=/tmp/vera_fidei_pdf_cache
PDF_CACHE_MAX_GB=5
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_PREFIX=pdfs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES=3600
GDRIVE_REMOTE=vera_drive
GDRIVE_PREFIX=vera-fidei/pdfs
RCLONE_BIN=rclone
VERA_RCLONE_TIMEOUT=600

# Instagram (API oficial) — geração é segura por padrão; publicação fica
# bloqueada até o template ser aprovado e as credenciais expostas serem
# substituídas. Use o host/fluxo indicado pelo painel do app Meta configurado.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_PUBLISH_ENABLED=false
# Data ISO da rotação feita depois da configuração, ex.: 2026-08-09T12:00:00Z
INSTAGRAM_CREDENTIALS_ROTATED_AT=
# O Agendador de Tarefas só deve ser instalado depois da aprovação visual.
INSTAGRAM_SCHEDULE_ENABLED=false
INSTAGRAM_SCHEDULE_TIMEZONE=America/Sao_Paulo

# Deploy do card diário — sobe a imagem via SFTP pro servidor de produção
# (pasta pública servida pelo Nginx em /social-cards/)
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=root
# Compatibilidade temporária. Prefira DEPLOY_SSH_KEY_PATH.
DEPLOY_SSH_PASSWORD=
DEPLOY_SSH_KEY_PATH=
DEPLOY_SSH_KNOWN_HOSTS=
DEPLOY_SOCIAL_CARDS_DIR=/var/www/verafidei-social-cards
DEPLOY_SOCIAL_CARDS_PUBLIC_BASE_URL=https://verafidei.oialfred.com/social-cards

# Identidade visual e trilha de auditoria. A fonte abaixo é a Arial Rounded MT
# Bold licenciada já instalada no Windows deste projeto. Não há substituição
# silenciosa: se ela faltar, a geração falha antes de publicar.
SOCIAL_BODY_FONT_PATH=C:/Windows/Fonts/ARLRDBD.TTF
SOCIAL_OUTPUT_DIR=scripts/output/instagram
SOCIAL_LEDGER_PATH=data/social/instagram_posts.jsonl
SOCIAL_STYLE_APPROVAL_PATH=data/social/style.approval.json
VERA_ENVIRONMENT=development
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
OWNER_EMAIL=mateuscirineo@gmail.com
