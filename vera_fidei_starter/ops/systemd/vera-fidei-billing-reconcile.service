[Unit]
Description=Reconcile Vera.Fidei subscriptions from Stripe and Google Play
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/vera_fidei
ExecStart=/usr/bin/docker compose exec -T backend python -m scripts.reconcile_billing_subscriptions --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
