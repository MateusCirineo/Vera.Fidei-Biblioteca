[Unit]
Description=Vera.Fidei PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Environment=VERA_PROJECT_DIR=/opt/vera_fidei
Environment=VERA_BACKUP_DIR=/var/backups/vera-fidei/postgres
Environment=VERA_BACKUP_RETENTION_DAYS=14
ExecStartPre=/usr/bin/install -d -m 0700 /var/backups/vera-fidei/postgres
ExecStart=/opt/vera_fidei/ops/backup_postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/vera-fidei/postgres

[Install]
WantedBy=multi-user.target
